# callback — environment variables
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Use .env, NOT .env.local: `vercel dev`'s serverless-function runtime loads
# .env; .env.local is only read by the Vite frontend. Both are gitignored.
# The same keys must also be set in the Vercel project
# (Settings -> Environment Variables) for deployed environments.
#
# If the database was provisioned through Vercel's Neon integration, the
# DATABASE_URL / POSTGRES_* vars already exist on the project — run
# `vercel env pull .env` to fetch them, then add the GitHub/session vars below.
#
# None of these are VITE_-prefixed, so none reach the browser bundle; they are
# read only by the /api serverless functions via process.env.

# --- Database (Neon) ---------------------------------------------------------
# Pooled connection string (host contains "-pooler"), e.g.
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- GitHub OAuth App ------------------------------------------------------
# github.com -> Settings -> Developer settings -> OAuth Apps -> your app.
# Registered callback URLs:
#   https://<prod-domain>/api/auth/callback
#   http://localhost:5173/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional signup gate: comma-separated GitHub logins allowed to create a new
# workspace. Empty = open signup (anyone with a GitHub account).
ALLOWED_GITHUB_LOGINS=

# --- Session cookie -------------------------------------------------------
# HMAC key for the session cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# --- App base URL --------------------------------------------------------
# Origin used to build the OAuth redirect_uri and post-login redirect.
# Local:  http://localhost:5173   (run: vercel dev --listen 5173)
# Vercel: https://<your-prod-domain>
APP_BASE_URL=http://localhost:5173
